{
  "name": "dsh-simple-memory",
  "version": "0.1.0",
  "description": "把 Markdown 记忆目录接入 DSH：每轮常驻索引，正文按需读取。",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "markdown",
    "obsidian"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liu-zhengdong/dsh-simple-memory.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "bench": "node test/benchmark.ts",
    "bench:keywords": "node test/benchmark-keywords.ts",
    "bench:store": "node test/benchmark-store.ts"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
