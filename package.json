{
  "name": "dsh-simple-memory",
  "version": "0.1.0",
  "description": "把 Markdown 记忆目录接入 DSH：每轮常驻索引，正文按需读取。",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "obsidian",
    "memory"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liu-zhengdong/dsh-simple-memory.git"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
